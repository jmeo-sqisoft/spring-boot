<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Java 소스와 MyBatis Mapper XML의 작성 규칙을 검사하는 Checkstyle 설정.
    Java와 XML은 탭을 허용하지 않는다. Java 한 줄은 최대 100자로 제한한다(일부 예외 적용).
    이름 표기법, import 순서, 필드 접근 제한, 중괄호와 공백 사용 등을 검사한다.
    위반 사항은 경고로 보고하며, 빌드 실패 기준은 build.gradle.kts에서 설정한다.
    검사 대상: 운영 Java 소스와 src/main/resources 아래 XML.
    테스트 소스는 Gradle의 checkstyleTest 작업을 비활성화해 제외한다.
    검사 실행: .\gradlew.bat checkstyleMain
    결과 보고서: build/reports/checkstyle/main.html
-->

<module name="Checker">
    <!-- ===========================================
         1. 공통 설정
         =========================================== -->
    <!-- 1.1 파일 인코딩: UTF-8 -->
    <property name="charset" value="UTF-8"/>
    <!-- 1.2 기본 위반 수준: 경고 -->
    <property name="severity" value="warning"/>
    <!-- 1.3 검사 파일 형식: Java와 XML -->
    <property name="fileExtensions" value="java,xml"/>
    <!-- 1.4 탭 문자 너비 계산: 4칸 -->
    <property name="tabWidth" value="4"/>

    <!-- ===========================================
         2. Java · XML 파일 포맷
         =========================================== -->

    <!-- 2.1 탭 문자 금지: 탭이 포함된 모든 Java·XML 행 검사 -->
    <module name="FileTabCharacter">
        <property name="fileExtensions" value="java,xml"/>
        <property name="eachLine" value="true"/>
    </module>

    <!-- 2.2 한 줄 최대 100자: package·import·URL 등 예외 적용 -->
    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="100"/>
        <property name="ignorePattern" value="^package.*|^import.*|a]+ href|href|http://|https://|ftp://"/>
    </module>

    <!-- 2.3 Java 파일 끝 개행 -->
    <module name="NewlineAtEndOfFile">
        <property name="fileExtensions" value="java"/>
    </module>

    <!-- ===========================================
         3. MyBatis XML · SQL 포맷
         =========================================== -->
    <!-- SELECT 목록, CASE 분기, JOIN의 ON 조건은 다음 줄에 작성한다.
         정규식은 SQL 구문을 해석하지 않는다. 별칭 참조·CASE 정렬·정확한 들여쓰기는 수동 확인한다.
         콤마·세미콜론 검사는 문자열·주석·XML 표기가 포함된 행을 제외한다. -->

    <!-- 3.1 FROM·WHERE의 첫 대상: 키워드와 같은 줄에 작성 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlClauseTarget"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^[ ]*(?:from|where)[ ]*$"/>
        <property name="message" value="SQL의 from/where 뒤 첫 대상은 같은 줄에 작성하세요."/>
    </module>

    <!-- 3.2 JOIN 대상: 키워드와 같은 줄에 작성 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlJoinTarget"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^[ ]*(?:(?:inner|cross|(?:left|right|full)(?:[ ]+outer)?)[ ]+)?join[ ]*$"/>
        <property name="message" value="SQL의 JOIN 대상은 키워드와 같은 줄에 작성하세요."/>
    </module>

    <!-- 3.3 SQL 문장 끝의 세미콜론 생략 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlNoSemicolon"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^(?!.*(?:'|&quot;|--|/\*|\*/|&lt;|&gt;|&amp;)).*;[ ]*$"/>
        <property name="message" value="SQL 문장 끝의 세미콜론은 생략하세요."/>
    </module>

    <!-- 3.4 파라미터 바인딩: SQL 행에서 ${...} 사용 금지. #{...} 사용 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlParameterBinding"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^(?![ ]*(?:&lt;|--|/\*|\*|\*/)).*\$\{[^}]+\}"/>
        <property name="message" value="SQL 파라미터는 MyBatis의 바인딩 문법으로 전달하고 문자열 직접 치환은 사용하지 마세요."/>
    </module>

    <!-- 3.5 선두 콤마: 이전 식의 줄 끝에 콤마를 붙이지 않음 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlLeadingComma"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^(?!.*(?:'|&quot;|--|/\*|\*/|&lt;|&gt;)).*,[ ]*$"/>
        <property name="message" value="SQL 콤마는 이전 줄 끝이 아닌 다음 식의 줄 앞에 작성하세요."/>
    </module>

    <!-- 3.6 선두 콤마 뒤 공백: 한 칸 사용 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlCommaSpacing"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="^(?!.*(?:'|&quot;|--|/\*|\*/|&lt;|&gt;))[ ]*,(?:[^ ]|[ ]{2,}\S)"/>
        <property name="message" value="SQL 줄 앞의 콤마 뒤에는 공백 한 칸을 사용하세요."/>
    </module>

    <!-- 3.7 왼쪽 외부 조인: SQL 행 시작의 LEFT OUTER JOIN 대신 left join 사용 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlLeftJoin"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?i)^[ ]*left[ ]+outer[ ]+join\b"/>
        <property name="message" value="왼쪽 외부 조인은 outer를 생략하고 left join으로 작성하세요."/>
    </module>

    <!-- 3.8 쿼리 시작 주석: /* Mapper명.쿼리ID */. CDATA 허용, id는 큰따옴표 기준.
         쿼리 ID는 역참조로 확인하며 Mapper명과 namespace의 일치는 수동 확인한다.
         본문 시작의 공백·CDATA를 원자 그룹으로 처리해 정상 주석의 중복 검출을 방지한다. -->
    <module name="RegexpMultiline">
        <property name="id" value="sqlQueryComment"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?s)&lt;(?:select|insert|update|delete)\b(?=[^&gt;]*\bid=&quot;([^&quot;]+)&quot;)[^&gt;]*&gt;(?>\s*(?:&lt;!\[CDATA\[\s*)?)(?!/\* [A-Za-z_][A-Za-z0-9_]*\.\1 \*/[ ]*(?:\r?\n|$))"/>
        <property name="message" value="SQL 첫 줄에 Mapper명과 쿼리 ID를 점으로 연결한 한 줄 블록 주석을 작성하세요."/>
    </module>

    <!-- 3.9 SELECT 목록: 단일 컬럼도 다음 줄에 작성. EXISTS용 select 1은 허용 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlSelectLineBreak"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?i)^[ ]*select[ ]+(?!--|/\*|1[ ]*(?:$|--))\S"/>
        <property name="message" value="SELECT 목록은 단일 컬럼이어도 select 다음 줄에 작성하세요."/>
    </module>

    <!-- 3.10 CASE 분기: case 또는 case 컬럼 뒤 WHEN은 다음 줄에 작성 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlCaseWhenLineBreak"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?i)^[ ]*(?:,[ ]+)?case(?:[ ]+[a-z_][a-z0-9_.]*)?[ ]+when\b"/>
        <property name="message" value="CASE의 when 분기는 case 다음 줄에 작성하세요."/>
    </module>

    <!-- 3.11 중첩 CASE: ELSE와 내부 CASE는 서로 다른 줄에 작성 -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlNestedCaseLineBreak"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?i)^[ ]*else[ ]+case\b"/>
        <property name="message" value="중첩 CASE는 else 다음 줄에 작성하세요."/>
    </module>

    <!-- 3.12 ON 조건: JOIN 대상 또는 서브쿼리의 닫는 괄호·별칭 다음 줄에 작성.
         문자열·주석·XML이 포함된 행과 동적 테이블 표현은 보수적으로 제외한다. -->
    <module name="RegexpSingleline">
        <property name="id" value="sqlJoinOnLineBreak"/>
        <property name="fileExtensions" value="xml"/>
        <property name="format" value="(?i)^(?!.*(?:'|&quot;|--|/\*|\*/|&lt;|&gt;))[ ]*(?:(?:(?:inner|left|right|full|cross)(?:[ ]+outer)?[ ]+)?join[ ]+[^\r\n]*|\)[ ]+(?:as[ ]+)?[a-z_][a-z0-9_]*)[ ]+on\b"/>
        <property name="message" value="JOIN의 on 조건은 대상 테이블 또는 닫는 괄호와 별칭의 다음 줄에 작성하세요."/>
    </module>

    <module name="TreeWalker">
        <property name="fileExtensions" value="java"/>
        <!-- ===========================================
             4. Java 구문 포맷
             =========================================== -->

        <!-- 4.1 들여쓰기: 공백 4칸 -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- 4.2 여는 중괄호: 선언·제어문과 같은 줄에 배치 -->
        <module name="LeftCurly">
            <property name="option" value="eol"/>
            <property name="tokens" value="ANNOTATION_DEF, CLASS_DEF, CTOR_DEF, ENUM_CONSTANT_DEF,
                ENUM_DEF, INTERFACE_DEF, LAMBDA, LITERAL_CASE, LITERAL_CATCH, LITERAL_DEFAULT,
                LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_SWITCH,
                LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, METHOD_DEF, OBJBLOCK,
                STATIC_INIT, RECORD_DEF, COMPACT_CTOR_DEF"/>
        </module>

        <!-- 4.3 닫는 중괄호: else·catch·finally를 같은 줄에 연결 -->
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE"/>
        </module>

        <!-- 4.4 제어문 본문의 중괄호 생략 금지 -->
        <module name="NeedBraces">
            <property name="tokens" value="LITERAL_DO, LITERAL_ELSE, LITERAL_FOR, LITERAL_IF, LITERAL_WHILE"/>
        </module>

        <!-- 4.5 메서드·생성자 이름과 여는 괄호 사이 공백·줄바꿈 금지 -->
        <module name="MethodParamPad">
            <property name="allowLineBreaks" value="false"/>
            <property name="option" value="nospace"/>
        </module>

        <!-- 4.6 이진·대입 연산자 양옆 공백 -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="tokens" value="ASSIGN, BAND, BAND_ASSIGN, BOR, BOR_ASSIGN, BSR, BSR_ASSIGN, BXOR,
                BXOR_ASSIGN, DIV, DIV_ASSIGN, EQUAL, GE, GT, LAND, LE, LOR, LT, MINUS, MINUS_ASSIGN,
                MOD, MOD_ASSIGN, NOT_EQUAL, PLUS, PLUS_ASSIGN, SL, SL_ASSIGN, SR, SR_ASSIGN, STAR, STAR_ASSIGN"/>
        </module>

        <!-- 4.7 쉼표·세미콜론 뒤 공백 -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>

        <!-- 4.8 캐스트의 닫는 괄호 뒤 공백 금지 -->
        <module name="TypecastParenPad">
            <property name="option" value="nospace"/>
        </module>

        <!-- 4.9 제어문·return 키워드 뒤 공백 -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_WHILE, LITERAL_DO,
                LITERAL_FOR, LITERAL_SWITCH, LITERAL_CATCH, LITERAL_TRY, LITERAL_FINALLY, LITERAL_RETURN"/>
        </module>

        <!-- 4.10 배열 선언: 대괄호를 타입 뒤에 배치 -->
        <module name="ArrayTypeStyle">
            <property name="javaStyle" value="true"/>
        </module>

        <!-- 4.11 접근 제어자·지시자 선언 순서 -->
        <module name="ModifierOrder"/>

        <!-- ===========================================
             5. Java 이름 규칙
             =========================================== -->

        <!-- 5.1 타입 이름: PascalCase -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="클래스/인터페이스명은 PascalCase를 사용하세요. 두문자어도 XmlHttpRequest 형식으로."/>
        </module>

        <!-- 5.2 패키지 이름: 소문자 기준, 각 구간 8자 이내 권장 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <message key="name.invalidPattern" value="패키지명은 소문자만 사용하세요."/>
        </module>

        <!-- 5.3 메서드 이름: camelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 5.4 멤버 변수 이름: camelCase -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="멤버 변수명은 camelCase를 사용하세요. 헝거리안 표기법(sName, mName), 언더스코어(_name) 금지."/>
        </module>

        <!-- 5.5 지역 변수 이름: camelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 5.6 매개변수 이름: camelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 5.7 상수 이름: UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- ===========================================
             6. Java 기본 코딩 규칙
             =========================================== -->

        <!-- 6.1 필드 접근: 기본 private, public 상수·허용된 public final 필드 등 예외 -->
        <module name="VisibilityModifier">
            <property name="allowPublicFinalFields" value="true"/>
            <property name="protectedAllowed" value="false"/>
        </module>

        <!-- 6.2 일반·static 와일드카드 import 금지 -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="false"/>
        </module>

        <!-- 6.3 switch의 default 누락 검사 -->
        <module name="MissingSwitchDefault"/>

        <!-- 6.4 사용하지 않는 import 금지 -->
        <module name="UnusedImports"/>

        <!-- 6.5 import 그룹 순서·그룹 간 빈 줄·그룹 내 이름순 정렬 -->
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
        </module>

        <!-- 6.6 지정된 제어문의 빈 블록 금지: 주석은 내용으로 인정 -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>

        <!-- 6.7 한 줄에 하나의 문장 -->
        <module name="OneStatementPerLine"/>

        <!-- 6.8 한 선언에 하나의 변수 -->
        <module name="MultipleVariableDeclarations"/>

        <!-- 6.9 equals()와 hashCode()를 함께 재정의 -->
        <module name="EqualsHashCode"/>

        <!-- 6.10 문자열 리터럴의 ==·!= 비교 금지 -->
        <module name="StringLiteralEquality"/>

        <!-- 6.11 불필요한 괄호 검사 -->
        <module name="UnnecessaryParentheses"/>

    </module>

</module>
